---
import { getEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import messages from '../../features/ai-slop-detector/i18n.json';

const project = await getEntry('projects', 'ai-slop-detector');
const copy = messages.en.interface;

if (!project) throw new Error('Missing AI slop detector project metadata.');
---

<ProjectLayout project={project} tool>
  <div class="detector" data-ai-slop-detector>
    <div class="detector__toolbar">
      <label for="detector-language" data-role="language-label">{copy.language}</label>
      <select id="detector-language" data-role="language"></select>
    </div>

    <div class="detector__editor">
      <label for="detector-input" data-role="input-label">{copy.input}</label>
      <textarea id="detector-input" data-role="input" rows="14" spellcheck="false"></textarea>
      <div class="detector__actions">
        <button type="button" data-action="analyze">{copy.analyze}</button>
        <button type="button" class="button-secondary" data-action="clear">{copy.clear}</button>
      </div>
    </div>

    <section class="detector__output" data-role="output" hidden aria-labelledby="detector-result-heading">
      <div class="detector__score-line">
        <div>
          <h2 id="detector-result-heading" data-role="score-label">{copy.score}</h2>
          <p class="detector__caveat" data-role="caveat">{copy.caveat}</p>
        </div>
        <strong class="detector__score" data-role="score" aria-live="polite">0.00%</strong>
      </div>
      <h3 data-role="evidence-heading">{copy.evidence}</h3>
      <ul class="detector__hits" data-role="hits"></ul>
      <h3 data-role="breakdown-heading">{copy.breakdown}</h3>
      <div class="detector__breakdown" data-role="breakdown" tabindex="0"></div>
    </section>
  </div>
</ProjectLayout>

<script>
  import { initAiSlopDetector } from '../../features/ai-slop-detector/ai-slop-detector';
  const root = document.querySelector<HTMLElement>('[data-ai-slop-detector]');
  if (root) initAiSlopDetector(root);
</script>

<style>
  .detector {
    display: grid;
    gap: var(--space-5);
    max-width: 58rem;
  }

  .detector__toolbar {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .detector__toolbar label {
    color: var(--ink-soft);
  }

  .detector__toolbar select {
    width: auto;
    min-width: 12rem;
  }

  .detector__editor {
    display: grid;
    gap: var(--space-2);
  }

  .detector__editor textarea {
    min-height: 19rem;
    font-family: var(--font-sans);
  }

  .detector__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .detector__output {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 2px solid var(--ink);
  }

  .detector__output[hidden] {
    display: none;
  }

  .detector__score-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .detector__score-line h2 {
    font-size: var(--step-2);
  }

  .detector__caveat {
    max-width: 48rem;
    margin-top: var(--space-1);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .detector__score {
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .detector__hits {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-left: 1.2rem;
  }

  .detector__hits :global(li) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--rule);
  }

  .detector__hits :global(li > span) {
    display: block;
    min-width: 0;
  }

  .detector__hits :global(small) {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .detector__hits :global(strong) {
    font-variant-numeric: tabular-nums;
  }

  .detector__breakdown {
    padding: var(--space-3);
    border: 1px solid var(--rule);
    background: var(--paper-light);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.75;
  }

  :global(.detector__mark) {
    position: relative;
    cursor: help;
    text-decoration-line: underline;
    text-decoration-thickness: 0.16em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: none;
  }

  :global(.detector__mark--1) { text-decoration-color: #d2a900; }
  :global(.detector__mark--2) { text-decoration-color: #e07b18; }
  :global(.detector__mark--3) { text-decoration-color: #c43b3b; }

  :global(.detector__tooltip) {
    position: fixed;
    z-index: 1000;
    width: min(28rem, calc(100vw - 1.5rem));
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 0.14);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.55;
    white-space: normal;
    overflow-wrap: anywhere;
    max-height: min(38rem, calc(100dvh - 1.5rem));
    overflow-y: auto;
    pointer-events: auto;
  }

  :global(.detector__tooltip-rule + .detector__tooltip-rule) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  :global(.detector__tooltip-heading) { display: flex; align-items: start; gap: 0.75rem; }
  :global(.detector__tooltip-title) { flex: 1; min-width: 0; font-size: 1rem; line-height: 1.4; }
  :global(.detector__tooltip-level) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  :global(.detector__tooltip-level::before) {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--level-color);
  }
  :global(.detector__tooltip-level--1) { --level-color: #d2a900; }
  :global(.detector__tooltip-level--2) { --level-color: #e07b18; }
  :global(.detector__tooltip-level--3) { --level-color: #c43b3b; }
  :global(.detector__tooltip-note) { margin: 0.65rem 0 0; }
  :global(.detector__tooltip-metrics) {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.2rem;
    font-size: 0.8125rem;
  }
  :global(.detector__tooltip-metrics > div) { display: flex; justify-content: space-between; gap: 1rem; }
  :global(.detector__tooltip-metrics dt) { color: var(--ink-soft); }
  :global(.detector__tooltip-metrics dd) { margin: 0; font-variant-numeric: tabular-nums; }
  :global(.detector__tooltip-detail) {
    margin: 0.7rem 0 0;
    padding-left: 0.6rem;
    border-left: 2px solid var(--rule-strong);
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }

  :global(.detector__tooltip[hidden]) { display: none; }
  :global(.detector__scope) { color: var(--ink-soft); font-size: var(--step--1); }
  :global(.detector__error) { color: var(--ink); }

  @media (max-width: 40rem) {
    .detector__toolbar,
    .detector__score-line {
      align-items: stretch;
      flex-direction: column;
    }

    .detector__toolbar select {
      width: 100%;
    }
  }
</style>
